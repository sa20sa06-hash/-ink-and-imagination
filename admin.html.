<body>
<header class="topbar"><div class="brand"><div class="mark">ح</div><div>حبر وخيال<small>INK & IMAGINATION · لوحة المالك</small></div></div><div style="display:flex;gap:8px"><button class="btn mobile-menu" id="menuBtn">☰ الأقسام</button><button class="btn hidden" id="logoutBtn">تسجيل الخروج</button></div></header>
<section id="loginView" class="login-wrap"><div class="login-card"><div class="mark">ح</div><h1>دخول المالك</h1><p class="sub">سجّل الدخول بحساب المالك المعتمد. لا تشارك كلمة المرور مع أي شخص.</p><div id="loginNotice"></div><form id="loginForm"><div class="field"><label for="email">البريد الإلكتروني</label><input id="email" type="email" autocomplete="username" required></div><div class="field"><label for="password">كلمة المرور</label><input id="password" type="password" autocomplete="current-password" required></div><button class="btn primary" style="width:100%">تسجيل الدخول</button></form><p class="note">تتحقق اللوحة من صلاحية المالك عبر is_site_admin().</p></div></section>
<div id="appView" class="layout hidden"><aside id="sidebar"><p class="note">إدارة الموقع</p><nav class="nav"><button class="active" data-page="home">⌂　الرئيسية</button><button data-page="stories">▤　القصص</button><button data-page="editor">＋　إنشاء قصة</button><button data-page="trash">♲　سلة المحذوفات</button></nav><p class="note">هذه النسخة تربط الوظائف الأساسية بالبيانات الحالية. يمكن إضافة أقسام الإدارة الأخرى لاحقًا.</p></aside><main>
<section id="page-home" class="page"><div class="page-head"><div><h1>الرئيسية</h1><div class="sub">ملخص سريع لحالة القصص والنشر.</div></div><button class="btn primary" data-goto="editor">＋ إنشاء قصة</button></div><div class="cards"><div class="stat"><span>كل القصص</span><strong id="statAll">—</strong></div><div class="stat"><span>منشورة</span><strong id="statPublished">—</strong></div><div class="stat"><span>في السلة</span><strong id="statTrash">—</strong></div></div><div class="panel"><div class="panel-head"><h2>أحدث القصص</h2><button class="btn" data-goto="stories">عرض الكل</button></div><div class="panel-body"><div id="recentStories" class="story-list"><div class="empty">جارٍ التحميل…</div></div></div></div></section>
<section id="page-stories" class="page hidden"><div class="page-head"><div><h1>القصص</h1><div class="sub">انشر القصة أو ألغِ نشرها دون حذفها.</div></div><button class="btn primary" data-goto="editor">＋ قصة جديدة</button></div><div class="panel"><div class="panel-body"><div class="toolbar"><input id="storySearch" placeholder="ابحث باسم القصة أو ملخصها"><button class="btn" id="refreshStories">تحديث</button></div></div></div><div id="storyList" class="story-list"></div></section>
<section id="page-editor" class="page hidden"><div class="page-head"><div><h1 id="editorHeading">إنشاء قصة</h1><div class="sub">تُحفظ القصة كمسودة. النشر إجراء منفصل.</div></div></div><div id="editorNotice"></div><form id="storyForm" class="panel"><div class="panel-body"><input type="hidden" id="storyId"><div class="field"><label for="storyTitle">عنوان القصة *</label><input id="storyTitle" maxlength="200" required></div><div class="field"><label for="storySynopsis">الملخص</label><textarea id="storySynopsis" maxlength="10000"></textarea></div><div class="field"><label for="storyLanguage">لغة القصة</label><select id="storyLanguage"><option value="ar">العربية</option><option value="en">English</option><option value="ja">日本語</option><option value="other">أخرى</option></select></div><div class="field"><label for="storyCover">مسار أو رابط الغلاف (اختياري)</label><input id="storyCover" placeholder="رابط صورة الغلاف"></div><p class="note">تأكد من إعداد سياسات قاعدة البيانات للسماح للمالك بالحفظ.</p><div class="toolbar"><button class="btn primary" type="submit">حفظ المسودة</button><button class="btn" id="cancelEdit" type="button">إلغاء والعودة</button></div></div></form></section>
<section id="page-trash" class="page hidden"><div class="page-head"><div><h1>سلة المحذوفات</h1><div class="sub">استعادة القصة كمسودة أو حذفها نهائيًا بعد التأكيد.</div></div><button class="btn" id="refreshTrash">تحديث</button></div><div class="notice">الحذف العادي ينقل القصة إلى السلة ولا يحذفها. الحذف النهائي غير قابل للتراجع.</div><div id="trashList" class="story-list"></div><div class="panel" style="margin-top:18px"><div class="panel-head"><h2>سجل عمليات الحذف</h2></div><div class="panel-body"><div id="trashLog" class="story-list"></div></div></div></section>
</main></div><button id="backButton" class="fixed-back hidden" type="button">➜ رجوع خطوة</button><div id="modalRoot"></div><div id="toast" class="toast hidden" role="status"></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><script>
const SUPABASE_URL="https://vyjgpssbaymcpxdqevsl.supabase.co";const SUPABASE_KEY="sb_publishable_p_bCr2qZksrqJXJJMYAHNQ_LvGxkPid";const db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);const $=id=>document.getElementById(id);let currentUser=null,storiesCache=[],pageStack=[],currentPage="home",toastTimer;
function toast(m,err=false){const e=$("toast");e.textContent=m;e.classList.remove("hidden");e.style.borderColor=err?"#744044":"#356c50";clearTimeout(toastTimer);toastTimer=setTimeout(()=>e.classList.add("hidden"),4500)}function notice(id,m,type="error"){const e=$(id);e.innerHTML="";const d=document.createElement("div");d.className="notice "+type;d.textContent=m;e.appendChild(d)}function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;", "'":"&#39;"}[c]))}
function status(s){return s.deleted_at?'<span class="pill deleted">في السلة</span>':s.status==="published"?'<span class="pill published">منشورة</span>':'<span class="pill draft">مسودة</span>'}function cover(s){return s.cover_path&&/^https?:\/\//i.test(s.cover_path)?`<img class="cover" src="${esc(s.cover_path)}" alt="${esc(s.title)}" onerror="this.style.visibility='hidden'">`:'<div class="cover">ح</div>'}
function card(s,trash=false){let a=trash?`<button class="btn green" data-action="restore" data-id="${esc(s.id)}">استعادة</button><button class="btn red" data-action="hard-delete" data-id="${esc(s.id)}">حذف نهائي</button>`:`${s.status==="published"?`<button class="btn" data-action="unpublish" data-id="${esc(s.id)}">إلغاء النشر</button>`:`<button class="btn green" data-action="publish" data-id="${esc(s.id)}">نشر</button>`}<button class="btn" data-action="edit" data-id="${esc(s.id)}">تعديل</button><button class="btn red" data-action="trash" data-id="${esc(s.id)}">نقل إلى السلة</button>`;let synopsis=esc(s.synopsis||"");return `<article class="story">${cover(s)}<div><div class="story-title">${esc(s.title||"قصة بلا عنوان")}</div><div class="story-meta">${status(s)}<span>معرّف: ${esc(String(s.id).slice(0,8))}</span></div>${synopsis?`<div class="sub">${synopsis.slice(0,160)}${synopsis.length>160?"…":""}</div>`:""}<div class="story-actions" style="margin-top:9px">${a}</div></div></article>`}
function go(page,push=true){if(!["home","stories","editor","trash"].includes(page))return;if(page===currentPage)return;if(push&&currentPage)pageStack.push(currentPage);currentPage=page;document.querySelectorAll(".page").forEach(e=>e.classList.add("hidden"));$("page-"+page).classList.remove("hidden");document.querySelectorAll("[data-page]").forEach(b=>b.classList.toggle("active",b.dataset.page===page));$("sidebar").classList.remove("open");$("backButton").classList.toggle("hidden",!currentUser);if(page==="stories")renderStories();if(page==="home")renderHome();if(page==="trash")loadTrash();window.scrollTo({top:0,behavior:"smooth"})}
function confirmBox(msg,yes,yesLabel="تأكيد"){const r=$("modalRoot");r.innerHTML=`<div class="modal-backdrop"><div class="modal"><h3>تأكيد العملية</h3><p class="sub">${esc(msg)}</p><div class="modal-actions"><button class="btn red" id="modalYes">${esc(yesLabel)}</button><button class="btn" id="modalNo">إلغاء</button></div></div></div>`;$ ("modalNo").onclick=()=>r.innerHTML="";$ ("modalYes").onclick=async()=>{r.innerHTML="";await yes()};r.querySelector(".modal-backdrop").addEventListener("click",e=>{if(e.target.classList.contains("modal-backdrop"))r.innerHTML=""})}
function back(){if(currentPage==="editor"&&$("storyForm").dataset.dirty==="true"){confirmBox("لديك تغييرات غير محفوظة. هل تريد الرجوع دون حفظها؟",()=>{ $("storyForm").reset();$("storyId").value="";$("storyForm").dataset.dirty="false";go(pageStack.pop()||"home",false)},"رجوع دون حفظ");return}go(pageStack.pop()||"home",false)}async function verifyOwner(){const {data,error}=await db.rpc("is_site_admin");if(error)throw Error("تعذر التحقق من صلاحية المالك: "+error.message);if(data!==true)throw Error("هذا الحساب ليس مالكًا معتمدًا. تحقق من public.site_admins.")}
async function activate(user){currentUser=user;try{await verifyOwner();$("loginView").classList.add("hidden");$("appView").classList.remove("hidden");$("logoutBtn").classList.remove("hidden");$("backButton").classList.remove("hidden");await loadStories();go("home",false)}catch(e){await db.auth.signOut();currentUser=null;notice("loginNotice",e.message)}}async function loadStories(){const {data,error}=await db.from("stories").select("id,title,synopsis,story_language,status,cover_path,author_id,created_at,updated_at,published_at,deleted_at").order("created_at",{ascending:false}).limit(500);if(error){toast("تعذر تحميل القصص: "+error.message,true);storiesCache=[];return}storiesCache=data||[];renderHome();renderStories()}
function renderHome(){const a=storiesCache.filter(s=>!s.deleted_at);$("statAll").textContent=a.length;$("statPublished").textContent=a.filter(s=>s.status==="published").length;$("statTrash").textContent=storiesCache.filter(s=>s.deleted_at).length;$("recentStories").innerHTML=a.length?a.slice(0,5).map(s=>card(s)).join(""):'<div class="empty">لا توجد قصص حتى الآن.</div>'}function renderStories(){const q=($("storySearch").value||"").trim().toLocaleLowerCase();const rows=storiesCache.filter(s=>!s.deleted_at&&((s.title||"").toLocaleLowerCase().includes(q)||(s.synopsis||"").toLocaleLowerCase().includes(q)));$("storyList").innerHTML=rows.length?rows.map(s=>card(s)).join(""):'<div class="empty">لا توجد قصص مطابقة.</div>'}
async function loadTrash(){const {data,error}=await db.from("stories").select("id,title,synopsis,story_language,status,cover_path,author_id,created_at,updated_at,published_at,deleted_at").not("deleted_at","is",null).order("deleted_at",{ascending:false});$("trashList").innerHTML=error?`<div class="empty">تعذر تحميل السلة: ${esc(error.message)}</div>`:data?.length?data.map(s=>card(s,true)).join(""):'<div class="empty">سلة المحذوفات فارغة.</div>';const log=await db.from("deleted_items_log").select("id,item_type,item_id,item_title,deleted_by,deleted_at,restored_at,permanently_deleted_at").order("deleted_at",{ascending:false}).limit(100);$("trashLog").innerHTML=log.error?`<div class="empty">تعذر تحميل السجل: ${esc(log.error.message)}</div>`:log.data?.length?log.data.map(x=>`<article class="story"><div class="cover">♲</div><div><div class="story-title">${esc(x.item_title)}</div><div class="story-meta"><span>${esc(x.item_type)}</span><span>${esc(new Date(x.deleted_at).toLocaleString())}</span>${x.restored_at?'<span class="pill published">استُعيدت</span>':''}${x.permanently_deleted_at?'<span class="pill deleted">حذف نهائي</span>':''}</div><div class="sub">معرّف العنصر: ${esc(x.item_id)}</div></div></article>`).join(""):'<div class="empty">لا توجد عمليات مسجلة.</div>'}
async function saveStory(e){e.preventDefault();const id=$("storyId").value;const p={title:$("storyTitle").value.trim(),synopsis:$("storySynopsis").value.trim()||null,story_language:$("storyLanguage").value,status:"draft",published_at:null,cover_path:$("storyCover").value.trim()||null};if(!p.title)return notice("editorNotice","اكتب عنوان القصة أولًا.");let r;if(id)r=await db.from("stories").update({...p,updated_at:new Date().toISOString()}).eq("id",id).select("id").single();else{p.author_id=currentUser.id;r=await db.from("stories").insert(p).select("id").single()}if(r.error)return notice("editorNotice","لم تُحفظ القصة: "+r.error.message);$("storyForm").reset();$("storyId").value="";$("storyForm").dataset.dirty="false";toast("تم حفظ القصة كمسودة.");await loadStories();go("stories")}
function editStory(id){const s=storiesCache.find(x=>x.id===id);if(!s)return;$("storyId").value=s.id;$("storyTitle").value=s.title||"";$("storySynopsis").value=s.synopsis||"";$("storyLanguage").value=s.story_language||"ar";$("storyCover").value=s.cover_path||"";$("editorHeading").textContent="تعديل القصة";$("storyForm").dataset.dirty="false";go("editor")}
function publish(id){confirmBox("سيتم نشر القصة لتصبح متاحة للزوار وفق سياسات القراءة. هل تريد المتابعة؟",async()=>{const {data,error}=await db.rpc("publish_story",{p_story_id:id});if(error||data!==true)return toast("فشل النشر: "+(error?.message||"لم تؤكد قاعدة البيانات النجاح"),true);toast("تم نشر القصة بنجاح.");await loadStories()},"نشر القصة")}function unpublish(id){confirmBox("سيتم إخفاء القصة عن الزوار مع الاحتفاظ بها في لوحة الإدارة. هل تريد المتابعة؟",async()=>{const {data,error}=await db.rpc("unpublish_story",{p_story_id:id});if(error||data!==true)return toast("فشل إلغاء النشر: "+(error?.message||"لم تؤكد قاعدة البيانات النجاح"),true);toast("تم إلغاء النشر.");await loadStories()},"إلغاء النشر")}
async function trashStory(id){const s=storiesCache.find(x=>x.id===id);if(!s)return;confirmBox("نقل «"+s.title+"» إلى سلة المحذوفات؟",async()=>{const {data,error}=await db.rpc("trash_story",{p_story_id:id});if(error||data!==true)return toast("تعذر نقل القصة: "+(error?.message||"فشلت العملية"),true);const lr=await db.from("deleted_items_log").insert({item_type:"story",item_id:id,item_title:s.title||"قصة بلا عنوان",deleted_by:currentUser.id});toast(lr.error?"نُقلت القصة لكن فشل تسجيلها في السجل: "+lr.error.message:"نُقلت القصة إلى السلة.",!!lr.error);await loadStories();if(currentPage==="trash")loadTrash()},"نقل إلى السلة")}
async function restoreStory(id){confirmBox("ستُستعاد القصة كمسودة ولن تُنشر تلقائيًا. هل تريد المتابعة؟",async()=>{const {data,error}=await db.rpc("restore_story",{p_story_id:id});if(error||data!==true)return toast("تعذرت الاستعادة: "+(error?.message||"فشلت العملية"),true);const r=await db.from("deleted_items_log").update({restored_at:new Date().toISOString()}).eq("item_id",id).eq("item_type","story").is("restored_at",null);toast(r.error?"استُعيدت القصة لكن تعذر تحديث السجل: "+r.error.message:"تمت استعادة القصة كمسودة.",!!r.error);await loadStories();await loadTrash()},"استعادة")}
async function hardDelete(id){confirmBox("تحذير: سيُحذف سجل القصة نهائيًا ولا يمكن التراجع. هل أنت متأكد؟",async()=>{const {error}=await db.from("stories").delete().eq("id",id).not("deleted_at","is",null);if(error)return toast("فشل الحذف النهائي: "+error.message,true);const r=await db.from("deleted_items_log").update({permanently_deleted_at:new Date().toISOString()}).eq("item_id",id).eq("item_type","story").is("permanently_deleted_at",null);toast(r.error?"حُذفت القصة لكن تعذر تحديث السجل: "+r.error.message:"تم الحذف النهائي.",!!r.error);await loadStories();await loadTrash()},"حذف نهائي")}
document.querySelectorAll("[data-page]").forEach(b=>b.onclick=()=>go(b.dataset.page));document.querySelectorAll("[data-goto]").forEach(b=>b.onclick=()=>go(b.dataset.goto));$("menuBtn").onclick=()=>$("sidebar").classList.toggle("open");$("backButton").onclick=back;$("refreshStories").onclick=loadStories;$("refreshTrash").onclick=loadTrash;$("storySearch").oninput=renderStories;$("cancelEdit").onclick=back;$("storyForm").onsubmit=saveStory;["storyTitle","storySynopsis","storyLanguage","storyCover"].forEach(id=>$(id).addEventListener("input",()=>$("storyForm").dataset.dirty="true"));$("storyForm").addEventListener("change",()=>$("storyForm").dataset.dirty="true");document.body.addEventListener("click",e=>{const b=e.target.closest("[data-action]");if(!b)return;const id=b.dataset.id;({publish,unpublish,edit:editStory,trash:trashStory,restore:restoreStory,"hard-delete":hardDelete}[b.dataset.action]||(()=>{}))(id)});
$("loginForm").onsubmit=async e=>{e.preventDefault();$("loginNotice").innerHTML="";const {data,error}=await db.auth.signInWithPassword({email:$("email").value.trim(),password:$("password").value});if(error)return notice("loginNotice","تعذر تسجيل الدخول: "+error.message);await activate(data.user)};$("logoutBtn").onclick=async()=>{await db.auth.signOut();currentUser=null;storiesCache=[];$("appView").classList.add("hidden");$("loginView").classList.remove("hidden");$("logoutBtn").classList.add("hidden");$("backButton").classList.add("hidden")};(async()=>{const {data}=await db.auth.getSession();if(data.session?.user)await activate(data.session.user)})();
